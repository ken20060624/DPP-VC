PORT=3000
HOST=127.0.0.1
ISSUER_DID_METHOD=key
# For web mode, PUBLIC_BASE_URL must be HTTPS and ISSUER_DID_WEB must match it.
# ISSUER_DID_WEB=did:web:issuer.example.com
ISSUER_VERIFICATION_METHOD_FRAGMENT=key-1
ISSUER_PRIVATE_KEY_PATH=./secrets/issuer-key.json
# Generate this value and retain the one-time plaintext key separately:
# npm run generate-api-key
OPERATOR_API_KEY_SHA256=replace-with-64-character-sha256-hex
PUBLIC_BASE_URL=http://127.0.0.1:3000
CREDENTIAL_STORE_ENABLED=true
CREDENTIAL_STORE_PATH=./data/credentials
STATUS_LIST_STORE_PATH=./data/status
CORS_ORIGINS=http://localhost:5173
